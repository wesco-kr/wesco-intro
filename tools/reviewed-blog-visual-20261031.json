        {
          "before": "<pre><code class=\"language-text\">Normal voltage   ----------------------\nSag              -----+       +--------\n                      +-------+          lower voltage, then recovery\nInterruption     -----+       +--------\n                      |       |\nZero voltage          +-------+          supply lost, then restored\n</code></pre>\n<table>\n<thead>\n<tr>\n<th>Question</th>\n<th>Voltage sag</th>\n<th>Supply interruption</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>What changes?</td>\n<td>Voltage magnitude falls</td>\n<td>Supply is interrupted</td>\n</tr>\n<tr>\n<td>Is it obvious?</td>\n<td>A flicker, or no visible sign</td>\n<td>Depends on duration and the connected load</td>\n</tr>\n<tr>\n<td>Can equipment stop?</td>\n<td>Controls, drives or contactors may trip</td>\n<td>Loads losing their supply may stop</td>\n</tr>\n<tr>\n<td>What should be recorded?</td>\n<td>Remaining voltage and duration</td>\n<td>Interruption time and duration</td>\n</tr>\n</tbody>\n</table>\n",
          "after": "<div style=\"margin:24px 0;overflow-x:auto;background:#faf8f4;border:1px solid #e5ded2;border-radius:12px;padding:16px\">\n<svg viewBox=\"0 0 680 250\" role=\"img\" aria-label=\"Concept diagram: voltage sag and interruption\" style=\"display:block;width:100%;min-width:480px;height:auto\" xmlns=\"http://www.w3.org/2000/svg\">\n<title>Concept diagram: voltage sag and interruption</title>\n<g font-family=\"Arial, sans-serif\" font-size=\"16\" fill=\"#292a25\">\n<text x=\"12\" y=\"36\">Normal voltage</text><text x=\"12\" y=\"104\">Voltage sag</text><text x=\"12\" y=\"185\">Interruption</text>\n<text x=\"192\" y=\"140\" font-size=\"14\" fill=\"#66665e\">Lower voltage, then recovery</text><text x=\"192\" y=\"242\" font-size=\"14\" fill=\"#66665e\">Supply lost, then restored</text>\n</g>\n<path d=\"M190 30 H650\" fill=\"none\" stroke=\"#7a7f76\" stroke-width=\"3\"/>\n<path d=\"M190 90 H320 V116 H505 V90 H650\" fill=\"none\" stroke=\"#d4471b\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n<path d=\"M190 170 H320 V214 H505 V170 H650\" fill=\"none\" stroke=\"#315b68\" stroke-width=\"4\" stroke-linejoin=\"round\"/>\n<path d=\"M190 214 H650\" fill=\"none\" stroke=\"#bbb8b0\" stroke-width=\"1\" stroke-dasharray=\"5 5\"/>\n<text x=\"155\" y=\"219\" font-family=\"Arial, sans-serif\" font-size=\"13\" fill=\"#66665e\">0</text>\n</svg>\n</div>\n\n<div style=\"overflow-x:auto;margin:20px 0\"><table style=\"width:100%;border-collapse:collapse;font-size:0.95em;line-height:1.6\">\n<tr><th style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;background:#f3eee5;\">Question</th><th style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;background:#f3eee5;\">Voltage sag</th><th style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;background:#f3eee5;\">Supply interruption</th></tr>\n<tr><td style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;\">What changes?</td><td style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;\">Voltage magnitude falls</td><td style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;\">Supply is interrupted</td></tr>\n<tr><td style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;\">Is it obvious?</td><td style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;\">A flicker, or no visible sign</td><td style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;\">Depends on duration and the connected load</td></tr>\n<tr><td style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;\">Can equipment stop?</td><td style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;\">Controls, drives or contactors may trip</td><td style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;\">Loads losing their supply may stop</td></tr>\n<tr><td style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;\">What should be recorded?</td><td style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;\">Remaining voltage and duration</td><td style=\"text-align:left;vertical-align:top;padding:12px;border:1px solid #dedbd3;\">Interruption time and duration</td></tr>\n</table></div>\n\n",
